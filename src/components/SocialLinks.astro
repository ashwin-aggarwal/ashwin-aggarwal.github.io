---
// Icon + label link chips for resume / GitHub / LinkedIn / X.
// Used in #about (all four) and in the footer contact box (a subset).
import { getBio } from '../lib/content';
import type { LinkKey as Key } from '../lib/icons';
import LinkIcon from './LinkIcon.astro';

interface Props {
  include?: Key[];
  class?: string;
}

const { include = ['resume', 'github', 'linkedin', 'x'], class: className } = Astro.props;
const bio = await getBio();

const all: { key: Key; label: string; href?: string }[] = [
  { key: 'resume', label: 'Resume', href: bio.data.resume },
  { key: 'github', label: 'GitHub', href: bio.data.github },
  { key: 'linkedin', label: 'LinkedIn', href: bio.data.linkedin },
  { key: 'x', label: 'X', href: bio.data.x },
];

const links = all.filter((l) => include.includes(l.key) && l.href);
---

<ul class:list={['social-links', className]}>
  {
    links.map((l) => (
      <li>
        <a class="social-link" href={l.href} aria-label={l.key === 'x' ? 'X (Twitter)' : undefined}>
          <LinkIcon name={l.key} class="social-link__icon" />
          <span>{l.label}</span>
          <svg class="social-link__arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3.5 8.5l5-5M4.5 3.5h4v4" />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
