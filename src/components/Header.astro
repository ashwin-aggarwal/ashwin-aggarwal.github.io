---
// Site-wide chrome. The header's bottom rule is a bus: every nav link taps
// into it with a short stub and a via pad, and the current route's tap is
// lit (green, active weight). The brand on the left is a small packaged chip
// plus the full name — the name is the conventional "home" cue, and off the
// homepage a "← home" subline spells it out. Hover/focus lighting is CSS
// only. Not sticky — it scrolls away with the page.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const links = [
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/experience/', label: 'Experience' },
  { href: '/blog/', label: 'Blog' },
  { href: '/readings/', label: 'Readings' },
  { href: '/coursework/', label: 'Coursework' },
  { href: '/news/', label: 'News' },
];
const isCurrent = (href: string) => path === href.replace(/\/$/, '') || path.startsWith(href);
// Three pins per edge on a 40-unit package.
const pins = [13, 20, 27];
---

<header class="site-header content-col">
  <a class="brand" href="/" aria-label="Ashwin Aggarwal, home" aria-current={isHome ? 'page' : undefined}>
    <svg class="brand__chip" viewBox="0 0 40 40" aria-hidden="true" fill="none">
      <g class="brand__pins">
        {pins.map((p) => <path d={`M${p} 2V7M${p} 33V38M2 ${p}H7M33 ${p}H38`} />)}
      </g>
      <rect class="brand__body" x="7" y="7" width="26" height="26" />
      <path class="brand__notch" d="M7 7h6L7 13z" />
      <text class="brand__label" x="20" y="23.2" text-anchor="middle">AKA</text>
    </svg>
    <span class="brand__text">
      <span class="brand__name">Ashwin Aggarwal</span>
      {!isHome && <span class="brand__hint" aria-hidden="true">← home</span>}
    </span>
  </a>

  <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Dark mode" data-theme-switch>
    <svg class="theme-switch__icon theme-switch__icon--sun" viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="3" />
      <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4" />
    </svg>
    <span class="theme-switch__track" aria-hidden="true"><span class="theme-switch__knob"></span></span>
    <svg class="theme-switch__icon theme-switch__icon--moon" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M13 10.2A5.6 5.6 0 0 1 5.8 3a5.6 5.6 0 1 0 7.2 7.2z" />
    </svg>
  </button>

  <nav class="bus" aria-label="Site">
    {
      links.map((l) => (
        <a class="bus__tap" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  // Theme switch (any [data-theme-switch]). BaseLayout's head script has
  // already set data-theme before paint; this keeps aria-checked in sync,
  // saves an explicit choice, and follows live system changes until one is
  // saved.
  const root = document.documentElement;
  const switches = document.querySelectorAll<HTMLButtonElement>('[data-theme-switch]');
  const mq = matchMedia('(prefers-color-scheme: dark)');

  const saved = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };
  const sync = () =>
    switches.forEach((sw) => sw.setAttribute('aria-checked', String(root.dataset.theme === 'dark')));
  const apply = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    sync();
  };

  switches.forEach((sw) =>
    sw.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', next);
      } catch {}
      apply(next);
    }),
  );

  mq.addEventListener('change', (e) => {
    const s = saved();
    if (s !== 'light' && s !== 'dark') apply(e.matches ? 'dark' : 'light');
  });

  sync();
</script>
