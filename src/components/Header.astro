---
// Site-wide chrome: brand mark (links home, to the die) + one link per
// route. The current route gets aria-current so it reads (and looks)
// selected. Not sticky — it scrolls away with the page.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/experience/', label: 'Experience' },
  { href: '/readings/', label: 'Readings' },
  { href: '/coursework/', label: 'Coursework' },
  { href: '/blog/', label: 'Blog' },
  { href: '/news/', label: 'News' },
];
const isCurrent = (href: string) => path === href.replace(/\/$/, '') || path.startsWith(href);
---

<header class="site-header content-col flex flex-wrap items-baseline gap-x-6 gap-y-3 pt-8 pb-4 text-[0.95rem]">
  <a class="brand-mark" href="/" aria-label="Ashwin Aggarwal, home">AKA</a>

  <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Site">
    {
      links.map((l) => (
        <a class="nav-link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
</header>
