---
// Experience as a transformer stack. One continuous residual stream runs
// up the left edge (data flows bottom → top, like a transformer diagram);
// each role is a layer that forks off the stream at its top and adds back
// into it at its bottom through a ⊕ node. Layer 1 is the earliest role, so
// the newest sits at the top of the stack and the page still reads
// newest-first.
//
// Each layer header is a real <button> inside the heading, with
// aria-expanded / aria-controls. With no JS every panel stays open (the
// inline script below is what collapses them), so nothing is ever locked
// shut.
import { render } from 'astro:content';
import './stack.css';
import { getExperience } from '../../lib/content';

const experience = await getExperience();
const rendered = await Promise.all(experience.map((item) => render(item)));
const total = experience.length;
---

<div class="tstack">
  <p class="tstack__cap tstack__cap--out" aria-hidden="true">residual stream</p>

  <ol class="tstack__layers" role="list">
    {
      experience.map((item, i) => {
        const { Content } = rendered[i];
        const n = total - i;
        const btnId = `layer-${n}-btn`;
        const panelId = `layer-${n}-panel`;
        return (
          <li class="layer is-open" data-layer>
            <span class="layer__fork" aria-hidden="true" />
            <span class="layer__merge" aria-hidden="true" />
            <span class="layer__add" aria-hidden="true" />

            <div class="layer__block">
              <h2 class="layer__heading">
                <button
                  type="button"
                  class="layer__toggle"
                  id={btnId}
                  aria-expanded="true"
                  aria-controls={panelId}
                  data-layer-toggle
                >
                  <span class="layer__index">Layer {n}<span class="sr-only">: </span></span>
                  <span class="layer__company">{item.data.company}<span class="sr-only">, </span></span>
                  <span class="layer__role">{item.data.role}<span class="sr-only">, </span></span>
                  <span class="layer__dates">
                    {item.data.start} – {item.data.end}
                  </span>
                  <span class="layer__sign" aria-hidden="true" />
                </button>
              </h2>

              <div class="layer__panel" id={panelId} role="region" aria-labelledby={btnId}>
                {item.data.location && <p class="layer__location">{item.data.location}</p>}
                <div class="layer__body">
                  <Content />
                </div>
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>

  <p class="tstack__cap tstack__cap--in" aria-hidden="true">input</p>
</div>

{/* Runs inline, straight after the list is parsed, so layers start
    collapsed with no flash of open panels. */}
<script is:inline>
  (function () {
    var layers = document.querySelectorAll('[data-layer]');
    function set(layer, open) {
      var btn = layer.querySelector('[data-layer-toggle]');
      var panel = document.getElementById(btn.getAttribute('aria-controls'));
      layer.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    }
    layers.forEach(function (layer) {
      set(layer, false);
      layer.querySelector('[data-layer-toggle]').addEventListener('click', function () {
        set(layer, !layer.classList.contains('is-open'));
      });
    });
  })();
</script>
