---
// Shared page heading for every routed page: the page name over one ink
// rule.
interface Props {
  title: string;
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
---

<header class:list={['page-head', { 'page-head--wide': wide }]}>
  <h1 class="page-head__title">{title}</h1>
</header>
