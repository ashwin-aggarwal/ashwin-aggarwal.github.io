---
// One row per project on /projects/, numbered 01, 02, … in the margin.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { anchorId } from '../lib/content';
import InlineSvg from './InlineSvg.astro';
import TypeText from './TypeText.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const displayIndex = String(data.order).padStart(2, '0');
// Hovering the row types the number, then the title (TypeText).
const indexLabel = displayIndex;
const mediaLeft = data.order % 2 === 1;
const isBrowserFrame = data.mediaFrame === 'browser';
// No fallback block when media is absent — some rows are text-only for now
// (see the project's own frontmatter) rather than showing a numbered
// placeholder. Set cover/video/logoMark to bring the media side back.
const hasMedia = Boolean(data.logoMark || data.video || data.cover);

// When a live demo URL is set, the media well itself becomes a link to it
// (in addition to any GitHub link rendered below) — otherwise it's a plain
// wrapper div. Astro supports dynamic tag names via a capitalized variable.
const MediaWrap = data.demoUrl ? 'a' : 'div';
const mediaWrapProps = data.demoUrl
  ? { href: data.demoUrl, target: '_blank', rel: 'noopener noreferrer', 'aria-label': `Open ${data.title} live demo` }
  : {};
---

<article
  id={anchorId(project.id)}
  class="project-row scroll-mt-24"
>
  <div class="marginal marginal--wide">
    <div class="marginal__meta">
      <p class="project-row__index" aria-hidden="true"><TypeText text={indexLabel} /></p>
    </div>

    <div class="marginal__content">
      <div class={hasMedia ? 'project-row__grid' : ''} data-media-side={hasMedia ? (mediaLeft ? 'left' : 'right') : undefined}>
        {
          hasMedia && (
            <div class="project-row__media">
            <MediaWrap class="project-row__media-wrap" {...mediaWrapProps}>
              {data.logoMark ? (
                <div class="media-well media-well--logo">
                  <InlineSvg path={`logos/${data.logoMark}`} class="media-well__logo-svg" />
                </div>
              ) : data.video ? (
                isBrowserFrame ? (
                  <div class="browser-frame">
                    <div class="browser-frame__bar" aria-hidden="true">
                      <span class="browser-frame__dot" />
                      <span class="browser-frame__dot" />
                      <span class="browser-frame__dot" />
                      <span class="browser-frame__url" />
                    </div>
                    <div class="media-well" data-media-well>
                      <video data-media muted loop playsinline preload="metadata" src={data.video} />
                    </div>
                  </div>
                ) : (
                  <div class="media-well" data-media-well>
                    <video data-media muted loop playsinline preload="metadata" src={data.video} />
                  </div>
                )
              ) : isBrowserFrame ? (
                <div class="browser-frame">
                  <div class="browser-frame__bar" aria-hidden="true">
                    <span class="browser-frame__dot" />
                    <span class="browser-frame__dot" />
                    <span class="browser-frame__dot" />
                    <span class="browser-frame__url" />
                  </div>
                  <div class="media-well">
                    <Image src={data.cover!} alt={data.coverAlt ?? ''} />
                  </div>
                </div>
              ) : (
                <div class="media-well">
                  <Image src={data.cover!} alt={data.coverAlt ?? ''} />
                </div>
              )}
            </MediaWrap>
            {/* Outside MediaWrap so it's never nested in the demo link. Its
                label and icon are kept in sync by mediaWell.js. */}
            {data.video && (
              <button type="button" class="media-toggle" data-media-toggle aria-label="Pause video">
                <svg class="media-toggle__icon media-toggle__icon--pause" viewBox="0 0 16 16" aria-hidden="true">
                  <rect x="4" y="3" width="3" height="10" />
                  <rect x="9" y="3" width="3" height="10" />
                </svg>
                <svg class="media-toggle__icon media-toggle__icon--play" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M5 3l8 5-8 5z" />
                </svg>
              </button>
            )}
            </div>
          )
        }

        <div class="project-row__text">
          <h2 class="title-mono">
            <TypeText text={data.title} offset={indexLabel.length} />
            {data.wip && <span class="title-mono__wip"> (WIP)</span>}
          </h2>

          <p class="eyebrow mt-1">{data.affiliation}</p>

          <p class="prose mt-3">{data.blurb}</p>

          <details class="disclosure mt-3">
            <summary class="cta disclosure__summary">
              <span class="disclosure__more">Read more</span>
              <span class="disclosure__less">Show less</span>
              <span class="disclosure__sign" aria-hidden="true" />
            </summary>
            <div class="disclosure__panel prose">
              <Content />
            </div>
          </details>

          {
            data.stack.length > 0 && (
              <p class="project-row__stack">{data.stack.join(', ')}</p>
            )
          }

          {
            data.links.length > 0 && (
              <p class="project-row__links">
                {data.links.map((link) => (
                  <a href={link.url}>{link.label}</a>
                ))}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</article>
