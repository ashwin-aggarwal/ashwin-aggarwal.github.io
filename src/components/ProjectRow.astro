---
// One row per project, reused wherever a project needs to render — right
// now that's only the #projects section, since this is a single-page site
// and each row's body renders inline (no separate project page).
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { anchorId, isVideoMedia } from '../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const index = String(data.order).padStart(2, '0');
const isVideo = isVideoMedia(data.media);
const mediaLeft = data.order % 2 === 1;
const isBrowserFrame = data.mediaFrame === 'browser';
---

<article
  id={anchorId(project.id)}
  class="project-row scroll-mt-24 py-12"
  style={`--project-accent: ${data.accent}`}
>
  <div class="marginal marginal--wide">
    <div class="marginal__meta">
      <div class="hidden lg:block">
        <p>{index}.</p>
        <p class="text-[color:var(--color-accent)] uppercase tracking-wide">{data.year}</p>
        {data.role && <p>{data.role}</p>}
      </div>
      <div class="flex flex-wrap gap-x-3 text-sm text-[color:var(--color-accent)] uppercase tracking-wide lg:hidden">
        <span>{data.year}</span>
        {data.role && <span>{data.role}</span>}
      </div>
    </div>

    <div class="marginal__content">
      <div class="project-row__grid" data-media-side={mediaLeft ? 'left' : 'right'}>
        <div class="project-row__media">
          {
            isBrowserFrame ? (
              <div class="browser-frame">
                <div class="browser-frame__bar" aria-hidden="true">
                  <span class="browser-frame__dot" />
                  <span class="browser-frame__dot" />
                  <span class="browser-frame__dot" />
                  <span class="browser-frame__url" />
                </div>
                <div class="media-well" data-media-well>
                  {
                    data.media &&
                      (isVideo ? (
                        <video data-media muted loop playsinline preload="metadata" src={`/media/${data.media}`} />
                      ) : (
                        <img data-media src={`/media/${data.media}`} alt="" loading="lazy" />
                      ))
                  }
                </div>
              </div>
            ) : (
              <div class="media-well" data-media-well>
                {
                  data.media &&
                    (isVideo ? (
                      <video data-media muted loop playsinline preload="metadata" src={`/media/${data.media}`} />
                    ) : (
                      <img data-media src={`/media/${data.media}`} alt="" loading="lazy" />
                    ))
                }
              </div>
            )
          }
        </div>

        <div class="project-row__text">
          <h3 class="font-display text-2xl">{data.title}</h3>

          {
            data.affiliation && (
              <p class="mt-1 text-xs tracking-wide text-[color:var(--color-ink-muted)] uppercase">
                {data.affiliation}
              </p>
            )
          }

          <p class="prose mt-3">{data.blurb}</p>

          <div class="prose mt-4 text-[color:var(--color-ink)]">
            <Content />
          </div>

          {
            data.stack.length > 0 && (
              <p class="prose mt-4 text-sm text-[color:var(--color-ink-muted)]">{data.stack.join(', ')}</p>
            )
          }

          {
            data.writeups.length > 0 && (
              <ol class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                {data.writeups.map((writeup, i) => (
                  <li>
                    <a href={`/journal/${writeup.slug.id}`}>
                      {i + 1}. {writeup.label}
                    </a>
                  </li>
                ))}
              </ol>
            )
          }

          {
            (data.repo || data.live) && (
              <p class="mt-3 flex gap-4 text-sm">
                {data.repo && <a href={data.repo}>Repo</a>}
                {data.live && <a href={data.live}>Live</a>}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</article>
