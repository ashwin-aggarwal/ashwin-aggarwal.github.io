---
// One row per project, reused wherever a project needs to render — right
// now that's only the #projects section, since this is a single-page site
// and each row's body renders inline (no separate project page).
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { anchorId } from '../lib/content';
import InlineSvg from './InlineSvg.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const displayIndex = String(data.order).padStart(2, '0');
const mediaLeft = data.order % 2 === 1;
const isBrowserFrame = data.mediaFrame === 'browser';
// No fallback block when media is absent — some rows are text-only for now
// (see the project's own frontmatter) rather than showing a numbered
// placeholder. Set cover/video/logoMark to bring the media side back.
const hasMedia = Boolean(data.logoMark || data.video || data.cover);
---

<article
  id={anchorId(project.id)}
  class="project-row scroll-mt-24 py-12"
  style={`--project-accent: ${data.accent}`}
>
  <div class="marginal marginal--wide">
    <div class="marginal__meta">
      <p class="project-row__index" data-typewriter aria-hidden="true">
        <span data-typewriter-text>{displayIndex}</span>
      </p>
    </div>

    <div class="marginal__content">
      <div class={hasMedia ? 'project-row__grid' : ''} data-media-side={hasMedia ? (mediaLeft ? 'left' : 'right') : undefined}>
        {
          hasMedia && (
            <div class="project-row__media">
              {data.logoMark ? (
                <div class="media-well media-well--logo">
                  <InlineSvg path={`logos/${data.logoMark}`} class="media-well__logo-svg" />
                </div>
              ) : data.video ? (
                isBrowserFrame ? (
                  <div class="browser-frame">
                    <div class="browser-frame__bar" aria-hidden="true">
                      <span class="browser-frame__dot" />
                      <span class="browser-frame__dot" />
                      <span class="browser-frame__dot" />
                      <span class="browser-frame__url" />
                    </div>
                    <div class="media-well" data-media-well>
                      <video data-media muted loop playsinline preload="metadata" src={data.video} />
                    </div>
                  </div>
                ) : (
                  <div class="media-well" data-media-well>
                    <video data-media muted loop playsinline preload="metadata" src={data.video} />
                  </div>
                )
              ) : isBrowserFrame ? (
                <div class="browser-frame">
                  <div class="browser-frame__bar" aria-hidden="true">
                    <span class="browser-frame__dot" />
                    <span class="browser-frame__dot" />
                    <span class="browser-frame__dot" />
                    <span class="browser-frame__url" />
                  </div>
                  <div class="media-well">
                    <Image src={data.cover!} alt={data.coverAlt ?? ''} />
                  </div>
                </div>
              ) : (
                <div class="media-well">
                  <Image src={data.cover!} alt={data.coverAlt ?? ''} />
                </div>
              )}
            </div>
          )
        }

        <div class="project-row__text">
          <h3
            class="title-mono"
            data-typewriter
            aria-label={data.wip ? `${data.title} (WIP)` : data.title}
          >
            <span data-typewriter-text aria-hidden="true">{data.title}</span>
            {data.wip && (
              <span class="title-mono__wip" aria-hidden="true"> (WIP)</span>
            )}
          </h3>

          <p class="eyebrow mt-1" data-typewriter aria-label={data.affiliation}>
            <span data-typewriter-text aria-hidden="true">{data.affiliation}</span>
          </p>

          <p class="prose mt-3">{data.blurb}</p>

          <details class="disclosure mt-3">
            <summary class="disclosure__summary">Read more</summary>
            <div class="prose mt-3 text-[color:var(--color-ink)]">
              <Content />
            </div>
          </details>

          {
            data.stack.length > 0 && (
              <p class="prose mt-4 text-sm text-[color:var(--color-ink-muted)]">{data.stack.join(', ')}</p>
            )
          }

          {
            data.links.length > 0 && (
              <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                {data.links.map((link) => (
                  <a href={link.url}>{link.label}</a>
                ))}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</article>
