---
// One row per project, reused wherever a project needs to render — right
// now that's only the #projects section, since this is a single-page site
// and each row's body renders inline (no separate project page).
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { anchorId } from '../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const displayIndex = String(data.order).padStart(2, '0');
const mediaLeft = data.order % 2 === 1;
const isBrowserFrame = data.mediaFrame === 'browser';
---

<article
  id={anchorId(project.id)}
  class="project-row scroll-mt-24 py-12"
  style={`--project-accent: ${data.accent}`}
>
  <div class="marginal marginal--wide">
    <div class="marginal__meta">
      <div class="hidden lg:block">
        <p>{displayIndex}.</p>
        <p class="text-[color:var(--color-accent)] uppercase tracking-wide">{data.year}</p>
      </div>
      <div class="flex flex-wrap gap-x-3 text-sm text-[color:var(--color-accent)] uppercase tracking-wide lg:hidden">
        <span>{data.year}</span>
      </div>
    </div>

    <div class="marginal__content">
      <div class="project-row__grid" data-media-side={mediaLeft ? 'left' : 'right'}>
        <div class="project-row__media">
          {
            data.cover ? (
              isBrowserFrame ? (
                <div class="browser-frame">
                  <div class="browser-frame__bar" aria-hidden="true">
                    <span class="browser-frame__dot" />
                    <span class="browser-frame__dot" />
                    <span class="browser-frame__dot" />
                    <span class="browser-frame__url" />
                  </div>
                  <div class="media-well">
                    <Image src={data.cover} alt={data.coverAlt ?? ''} />
                  </div>
                </div>
              ) : (
                <div class="media-well">
                  <Image src={data.cover} alt={data.coverAlt ?? ''} />
                </div>
              )
            ) : (
              <div class="media-well media-well--fallback" aria-hidden="true">
                <span class="media-well__fallback-index">{displayIndex}</span>
              </div>
            )
          }
        </div>

        <div class="project-row__text">
          <h3 class="font-display text-2xl">{data.title}</h3>

          <p class="mt-1 text-xs tracking-wide text-[color:var(--color-ink-muted)] uppercase">
            {data.affiliation}
          </p>

          <p class="prose mt-3">{data.blurb}</p>

          <details class="project-row__details mt-3">
            <summary class="project-row__summary">Read more</summary>
            <div class="prose mt-3 text-[color:var(--color-ink)]">
              <Content />
            </div>
          </details>

          {
            data.stack.length > 0 && (
              <p class="prose mt-4 text-sm text-[color:var(--color-ink-muted)]">{data.stack.join(', ')}</p>
            )
          }

          {
            data.links.length > 0 && (
              <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                {data.links.map((link) => (
                  <a href={link.url}>{link.label}</a>
                ))}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</article>
