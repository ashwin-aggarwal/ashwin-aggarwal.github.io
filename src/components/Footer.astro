---
import { getBio } from '../lib/content';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
const bio = await getBio();
---

<footer class="site-footer content-col py-8 pb-12 text-[0.85rem] text-[color:var(--color-ink-muted)]">
  <div class="footer-contact" id="contact">
    <p class="m-0">
      Please reach out at <a href={`mailto:${bio.data.email}`}>{bio.data.email}</a>
    </p>
    <SocialLinks class="mt-3" include={['linkedin', 'x']} />
  </div>

  <p class="mt-6 mb-0">&copy; {year} Ashwin Aggarwal.</p>
</footer>
