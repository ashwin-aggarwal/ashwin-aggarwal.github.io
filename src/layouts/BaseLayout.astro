---
import '../styles/global.css';
// Self-hosted, sitewide fonts only — IBM Plex Sans (reading) and IBM Plex
// Mono (labels). Caveat is bookshelf-only and is imported from
// components/bookshelf/Bookshelf.astro instead, never here.
import '@fontsource/ibm-plex-sans/latin.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ashwin Aggarwal',
  description = 'Personal site and reading room.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
