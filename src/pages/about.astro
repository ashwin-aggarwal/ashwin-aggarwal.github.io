---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getBio } from '../lib/content';

const bio = await getBio();
const { Content: BioContent } = await render(bio);
---

<BaseLayout title="About — Ashwin Aggarwal">
  <section id="about" class="content-col content-col--wide py-16">
    <div class="about-grid">
      <div class="min-w-0">
        <p class="eyebrow">{bio.data.identityLine}</p>
        <h1 class="font-display mt-2 text-4xl sm:text-5xl">{bio.data.name}</h1>

        <div class="prose mt-6 text-[#000]">
          <BioContent />
        </div>

        {bio.data.location && <p class="mt-6 mb-0 text-sm text-[color:var(--color-ink-muted)]">{bio.data.location}</p>}
        <SocialLinks class="mt-4" />
      </div>

      <div class="about-grid__headshot" data-media-well>
        {bio.data.headshot && <img data-media src={bio.data.headshot} alt="" width="320" height="320" />}
      </div>
    </div>
  </section>

</BaseLayout>
