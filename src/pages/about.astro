---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getBio } from '../lib/content';

const bio = await getBio();
const { Content: BioContent } = await render(bio);
---

<BaseLayout title="About — Ashwin Aggarwal">
  <PageHead title="About" part="GigaThread engine" wide />

  <section class="about">
    <div class="about__text">
      <p class="about__identity">{bio.data.identityLine}</p>
      <h2 class="about__name">{bio.data.name}</h2>

      <div class="about__bio prose">
        <BioContent />
      </div>

      {bio.data.location && <p class="about__location">{bio.data.location}</p>}
      <SocialLinks class="mt-6" />
    </div>

    {
      bio.data.headshot && (
        <figure class="about__photo">
          <img src={bio.data.headshot} alt="" width="320" height="320" />
        </figure>
      )
    }
  </section>
</BaseLayout>
