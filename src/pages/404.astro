---
// Standalone: no nav, no footer. Astro outputs this to dist/404.html, which
// GitHub Pages serves for unmatched routes. The chip mark is the way home.
import '../styles/global.css';
import '@fontsource/ibm-plex-sans/latin.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import ChipMark from '../components/ChipMark.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>404 — Ashwin Aggarwal</title>
  </head>
  <body>
    <main class="notfound">
      <a href="/" class="notfound__mark" aria-label="Return to homepage">
        <ChipMark class="notfound__mark-svg" />
      </a>
      <div class="notfound__copy">
        <h1 class="notfound__title">404 — this page is somewhere else. The logo knows the way.</h1>
        <p class="notfound__hint">Click the logo to go home.</p>
      </div>
    </main>
  </body>
</html>
