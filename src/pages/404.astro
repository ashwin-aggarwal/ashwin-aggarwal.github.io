---
// Standalone: no nav, no footer. Astro outputs this to dist/404.html, which
// GitHub Pages serves for unmatched routes. The chip mark is the way home,
// and it bounces around the screen like a DVD logo (scripts/bounce.js).
import '../styles/global.css';
import '@fontsource/ibm-plex-sans/latin.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import ChipMark from '../components/ChipMark.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>404 — Ashwin Aggarwal</title>
  </head>
  <body>
    <main class="notfound" id="notfound">
      <a href="/" class="notfound__mark" id="notfound-mark" aria-label="Return to homepage">
        <ChipMark class="notfound__mark-svg" />
      </a>
      <div class="notfound__copy">
        <h1 class="notfound__title">404 — this page is somewhere else. The logo knows the way.</h1>
        <p class="notfound__hint">Click the logo to go home.</p>
      </div>
      <p class="notfound__egg" id="notfound-egg" aria-hidden="true">huh, a corner.</p>
    </main>

    <script>
      import { initBounce } from '../scripts/bounce.js';

      const stage = document.getElementById('notfound');
      const mark = document.getElementById('notfound-mark');
      const egg = document.getElementById('notfound-egg');
      if (stage && mark) initBounce(stage, mark, egg);
    </script>
  </body>
</html>
