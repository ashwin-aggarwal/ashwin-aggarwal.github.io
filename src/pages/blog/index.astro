---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { getBlogPosts } from '../../lib/content';
import { formatDate, isoDate } from '../../lib/dates';

const posts = await getBlogPosts();
const slugs = posts.map((p) => p.id);
---

<BaseLayout
  title="Blog — Ashwin Aggarwal"
  description="Writing by Ashwin Aggarwal on AI, machine learning, and the questions around them."
>
  <PageHead title="Blog" part="L2 cache" />

  {/* Posts used to open in place at /blog/#slug; forward those links. */}
  <script is:inline define:vars={{ slugs }}>
    (function () {
      var h = decodeURIComponent(location.hash.slice(1));
      if (h && slugs.indexOf(h) !== -1) location.replace('/blog/' + h + '/');
    })();
  </script>

  <ol class="post-list" role="list">
    {
      posts.map((post) => {
        const updated = post.data.updated ?? post.data.published;
        return (
          <li class="post-item">
            <h2 class="post-item__title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="post-item__description">{post.data.description}</p>
            <p class="post-item__dates">
              <span>
                Published <time datetime={isoDate(post.data.published)}>{formatDate(post.data.published)}</time>
              </span>
              {updated.valueOf() !== post.data.published.valueOf() && (
                <span>
                  Last edited <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
                </span>
              )}
            </p>
          </li>
        );
      })
    }
  </ol>
</BaseLayout>
