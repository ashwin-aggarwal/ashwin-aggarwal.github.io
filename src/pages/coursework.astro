---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { getCoursework } from '../lib/content';
import { COURSE_AREAS } from '../content.config';

const courses = await getCoursework();
const groups = COURSE_AREAS.map((area) => ({
  area,
  list: courses.filter((c) => c.data.area === area),
})).filter((g) => g.list.length);
---

<BaseLayout title="Coursework — Ashwin Aggarwal">
  <PageHead title="Coursework" part="GPC 3" />

  <section class="courses">
    {
      groups.length ? (
        groups.map(({ area, list }) => (
          <section class="term">
            <h2 class="term__name">{area}</h2>
            <ul class="term__grid" role="list">
              {list.map((c) => (
                <li class="course">
                  <span class="course__code">{c.data.code}</span>
                  <span class="course__title">{c.data.title}</span>
                  {(c.data.note || c.data.term) && (
                    <span class="course__meta">{[c.data.note, c.data.term].filter(Boolean).join(', ')}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        <p class="empty-state">No courses listed yet.</p>
      )
    }
  </section>
</BaseLayout>
