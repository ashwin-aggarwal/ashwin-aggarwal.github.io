---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Bookshelf from '../components/bookshelf/Bookshelf.astro';
import BookStage from '../components/bookshelf/BookStage.astro';
import DieMap from '../components/die/DieMap.astro';
import { anchorId, getBio, getNowItems, getProjects, getJournalEntries } from '../lib/content';

const bio = await getBio();

const nowItems = await getNowItems();
const nowRendered = await Promise.all(nowItems.map((item) => render(item)));

const projectIds = (await getProjects()).map((p) => anchorId(p.id));

const journalEntries = await getJournalEntries();
const journalByYear = new Map<number, typeof journalEntries>();
for (const entry of journalEntries) {
  const year = entry.data.date.getUTCFullYear();
  const bucket = journalByYear.get(year) ?? [];
  bucket.push(entry);
  journalByYear.set(year, bucket);
}

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });
---

<BaseLayout>
  <section class="home-intro content-col py-12">
    <h1 class="home-intro__name">{bio.data.name}</h1>
    <p class="home-intro__tagline">{bio.data.tagline}</p>
  </section>

  <DieMap />

  {/* Old single-page deep links (/#about, /#leaselooker, ...) now live on
      their own routes. Hashes never reach the server, so forward them here. */}
  <script is:inline define:vars={{ projectIds }}>
    (function () {
      var h = location.hash.slice(1);
      if (!h) return;
      if (h === 'about' || h === 'projects' || h === 'experience') location.replace('/' + h + '/');
      else if (projectIds.indexOf(h) !== -1) location.replace('/projects/#' + h);
    })();
  </script>

  {
    // "Recent News" — disabled for now. To bring it back: flip this to
    // true (the content itself lives in src/content/now/*.md, still
    // three empty bullets waiting to be filled in).
    false && (
      <section id="now" class="scroll-mt-24 py-10">
        <div class="marginal">
          <div class="marginal__content">
            <h2 class="section-title" data-typewriter aria-label="Recent News">
              <span data-typewriter-text aria-hidden="true">Recent News</span>
            </h2>
          </div>
        </div>

        <div class="mt-6 space-y-6">
          {nowItems.map((item, i) => {
            const { Content } = nowRendered[i];
            return (
              <div class="marginal">
                <div class="marginal__meta">{item.data.label}</div>
                <div class="marginal__content prose">
                  <Content />
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  {
    // Journal — hidden for now. To bring it back: flip this to true (and
    // restore the header nav link in Header.astro).
    false && (
      <section id="journal" class="scroll-mt-24 py-10">
        <div class="marginal">
          <div class="marginal__content">
            <h2 class="section-title" data-typewriter aria-label="Journal">
              <span data-typewriter-text aria-hidden="true">Journal</span>
            </h2>
          </div>
        </div>

        <div class="mt-6 space-y-10">
          {[...journalByYear.entries()]
            .sort((a, b) => b[0] - a[0])
            .map(([year, entries]) => (
              <div class="marginal">
                <div class="marginal__meta">{year}</div>
                <div class="marginal__content space-y-5">
                  {entries.map((entry) => (
                    <div>
                      <p class="text-xs tracking-wide text-[color:var(--color-ink-muted)] uppercase">
                        {dateFormatter.format(entry.data.date)}
                      </p>
                      <h3 class="font-display text-lg">
                        <a href={`/journal/${entry.id}`}>{entry.data.title}</a>
                      </h3>
                      {entry.data.blurb && <p class="prose mt-1 text-sm">{entry.data.blurb}</p>}
                    </div>
                  ))}
                </div>
              </div>
            ))}
        </div>
      </section>
    )
  }

  {
    // Bookshelf — hidden for now. To bring it back: flip this to true.
    false && (
      <>
        <div class="marginal pt-10">
          <div class="marginal__meta">Bookshelf</div>
          <div class="marginal__content"></div>
        </div>
        <Bookshelf />
        <BookStage />
      </>
    )
  }
  <script>
    import '../scripts/main.js';
  </script>
</BaseLayout>
