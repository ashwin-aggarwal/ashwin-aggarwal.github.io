---
// Readings: a horizontal wheel of covers. Native scroll with snap points —
// swipe, trackpad, shift+wheel, or the arrow keys once the wheel has focus;
// the two buttons step one book at a time. Where scroll-driven animations
// are supported (and motion is allowed), books ease down in size and
// opacity as they move off-center, which is what makes it read as a wheel.
//
// Under each book, a status readout like a board's activity light: a green
// LED and four square progress lights (one per quarter, like a game
// controller's player lights) for books being read; a hollow LED and four
// gray lights for finished ones.
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { getReadings } from '../lib/content';

const books = await getReadings();
const rendered = await Promise.all(books.map((b) => render(b)));
---

<BaseLayout title="Readings — Ashwin Aggarwal">
  <PageHead title="Readings" wide />

  <section class="wheel" data-wheel>
    {
      books.length ? (
        <>
          <div class="wheel__viewport" tabindex="0" role="region" aria-label="Books, scroll sideways" data-wheel-viewport>
            <ol class="wheel__track" role="list">
              {books.map((book, i) => {
                const { Content } = rendered[i];
                return (
                  <li class="book">
                    {book.data.cover ? (
                      <figure class="book__cover">
                        <Image src={book.data.cover} alt="" width={320} />
                      </figure>
                    ) : (
                      <figure class="book__cover book__cover--type" aria-hidden="true">
                        <span class="book__cover-title">{book.data.title}</span>
                        <span class="book__cover-author">{book.data.author}</span>
                      </figure>
                    )}
                    <p class="book__title">{book.data.title}</p>
                    <p class="book__author">{book.data.author}</p>
                    {(() => {
                      const reading = book.data.status === 'reading';
                      const p = reading ? book.data.progress : 100;
                      return (
                        <div class:list={['book__status', { 'book__status--on': reading }]}>
                          <span class="book__led" aria-hidden="true" />
                          <span class="book__state">{reading ? 'Reading now' : 'Finished'}</span>
                          {p !== undefined && (
                            <span
                              class="book__meter"
                              role={reading ? 'progressbar' : undefined}
                              aria-label={reading ? `Progress through ${book.data.title}` : undefined}
                              aria-valuenow={reading ? p : undefined}
                              aria-valuemin={reading ? 0 : undefined}
                              aria-valuemax={reading ? 100 : undefined}
                              aria-hidden={reading ? undefined : 'true'}
                            >
                              {[1, 2, 3, 4].map((q) => (
                                <span class:list={['book__seg', { 'book__seg--lit': Math.round(p / 25) >= q }]} />
                              ))}
                            </span>
                          )}
                        </div>
                      );
                    })()}
                    {book.body?.trim() && (
                      <div class="book__note">
                        <Content />
                      </div>
                    )}
                  </li>
                );
              })}
            </ol>
          </div>
          <div class="wheel__controls">
            <button type="button" class="wheel__btn" data-wheel-step="-1" aria-label="Previous book">
              <span class="wheel__chev wheel__chev--prev" aria-hidden="true" />
            </button>
            <button type="button" class="wheel__btn" data-wheel-step="1" aria-label="Next book">
              <span class="wheel__chev" aria-hidden="true" />
            </button>
          </div>
        </>
      ) : (
        <p class="empty-state">No books listed yet.</p>
      )
    }
  </section>

  <script>
    const viewport = document.querySelector<HTMLElement>('[data-wheel-viewport]');
    if (viewport) {
      const step = () => viewport.querySelector<HTMLElement>('.book')?.offsetWidth ?? 240;
      const smooth = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      document.querySelectorAll<HTMLButtonElement>('[data-wheel-step]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = Number(btn.dataset.wheelStep);
          viewport.scrollBy({ left: dir * step(), behavior: smooth() });
        });
      });
    }
  </script>
</BaseLayout>
