---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getProjects } from '../lib/content';

const projects = await getProjects();
---

<BaseLayout title="Projects — Ashwin Aggarwal">
  <PageHead title="Projects" wide />

  <div class="project-list">
    {projects.map((project) => <ProjectRow project={project} />)}
  </div>

  <script>
    import { initCoverVideos } from '../scripts/mediaWell.js';

    initCoverVideos();
  </script>
</BaseLayout>
